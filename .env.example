# IntentRadar — environment template.
# Copy to `.env` (never committed) and fill in. All values below are placeholders.

# ── Collection (ScrapeCreators) ────────────────────────────────────────────
# Required for `intentradar run`. Missing -> exit code 2 with a friendly message.
SCRAPECREATORS_API_KEY=

# ── LLM (Nebius Token Factory / NVIDIA Nemotron) ───────────────────────────
# Empty NEBIUS_API_KEY is fine: the pipeline runs in mock mode and never blocks.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# REQUIRED once you have a key. Get the exact slug from Token Factory docs /
# playground — do NOT guess, the case differs between models.
#   reasoning -> Nemotron Ultra      e.g. nvidia/Nemotron-3-Ultra-550b-a55b
#   everyday  -> Nemotron Super/Nano e.g. nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL_EVERYDAY=
NEBIUS_MODEL_REASONING=

# Optional overrides. INTENTRADAR_LLM_* wins over NEBIUS_* and is how you point
# the same code at a different provider without editing anything:
#   INTENTRADAR_LLM_BASE_URL=
#   INTENTRADAR_LLM_API_KEY=
#   INTENTRADAR_LLM_MODEL=
# Protocol: auto (sniffed from the URL) | openai (/v1/chat/completions) |
# anthropic (/v1/messages). Set it explicitly when the URL is ambiguous.
#   INTENTRADAR_LLM_BACKEND=auto
# Reasoning models spend part of the budget on chain-of-thought before the
# answer; 8192 leaves room for both halves (2048 was measured to truncate).
#   INTENTRADAR_LLM_MAX_TOKENS=8192
#   INTENTRADAR_LLM_TIMEOUT_S=60

# ── Proxy (replaces the old hardcoded 127.0.0.1:10808) ─────────────────────
# Leave empty for a direct connection. httpx reads these automatically.
HTTPS_PROXY=
HTTP_PROXY=

# ── Paths ──────────────────────────────────────────────────────────────────
# Defaults are repo-relative, never CWD-relative, so the CLI works from anywhere.
# INTENTRADAR_DATA_DIR=
# INTENTRADAR_WATCHLIST=

# ── Gates & budget ─────────────────────────────────────────────────────────
# Per SUBREDDIT, not per run: five subreddits of 40 posts never trips 200.
INTENTRADAR_MAX_POSTS_PER_SOURCE=200
INTENTRADAR_MAX_LLM_CALLS=50
INTENTRADAR_MONTHLY_BUDGET_USD=20
# auto = mock when no NEBIUS_API_KEY. Set 1 / 0 to force.
INTENTRADAR_LLM_MOCK=auto
# 1 = models missing from MODEL_PRICING are billed at the conservative fallback
#     estimate ($0.30 in / $1.20 out per 1M tokens) and log a WARNING.
# 0 = refuse to call a model that has no configured price (ConfigError, exit 2).
#     Use this if you want the budget gate to be exact rather than approximate.
# Mock mode is always exempt — it is offline and costs nothing.
INTENTRADAR_ALLOW_UNPRICED=1
